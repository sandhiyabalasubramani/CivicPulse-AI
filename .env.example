# ==============================================================================
# CivicPulse AI - Environment Configuration Template
# Duplicate this file to '.env' and provide your actual credentials.
# Never commit '.env' containing real secrets to version control.
# ==============================================================================

# PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicpulse

# Secret Administrator API Key for Protected Operations (e.g. Status Updates)
# Generate a strong, random key for production deployments
ADMIN_API_KEY=your_secure_admin_api_key_here

# FastAPI Backend Service URL
# Used by the Streamlit frontend client (default local development: http://127.0.0.1:8001)
API_URL=http://127.0.0.1:8001
